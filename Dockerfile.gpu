# CUDA build of the MMC environment, for the GPU-shaped workloads.
#
# The structural backend runs here but is slower than the CPU image. The fixed-point solve
# over 28 genes does not fill the card, and scipy L-BFGS-B drives the optimisation from the
# host, so every step pays a round trip. Use the CPU image for the structure search.
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "duckdb>=1.0" "polars>=1.0" "pandas>=2.0" "numpy>=1.26" "scipy>=1.11" \
    "pydantic>=2.6" "cma>=3.3" "anthropic>=0.116" "matplotlib>=3.8" "pytest>=8.0" \
    "scikit-learn>=1.3" \
    && pip install --no-cache-dir "jax[cuda12]>=0.4.30"

ENV PYTHONPATH=/app
# Do not let JAX reserve the whole card; the host shares it with other projects.
ENV XLA_PYTHON_CLIENT_PREALLOCATE=false
ENV XLA_PYTHON_CLIENT_MEM_FRACTION=0.5
CMD ["pytest", "-q"]
